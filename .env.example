# ============================================
# LSPD - إعدادات البيئة (Environment Variables)
# انسخ هذا الملف إلى ".env" وعبّئ القيم الفعلية.
# لا ترفع ملف ".env" الحقيقي إلى GitHub أبداً.
# ============================================

# المنفذ المحلي (3001)
PORT=3001

# --- Discord Application (من Discord Developer Portal) ---
# Client ID
DISCORD_CLIENT_ID=1534884276645134478
# Client Secret
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET_HERE

# --- Discord Bot ---
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# --- السيرفر ---
# ايدي سيرفر الديسكورد
DISCORD_GUILD_ID=1511172687463186553
# رتبة الأفراد التي يظهر بها نظام الخدمة والموجه
TARGET_ROLE_ID=1534317414521503876
# رابط دعوة السيرفر
DISCORD_INVITE=https://discord.gg/rhARTUuX7u

# --- القادة الذين يمكنهم الكتابة (مفصولة بفواصل) ---
ADMIN_IDS=1490661913288380488 , 1486652608746885242 , 1511111399558873178 , 1443547306518642703 , 1037375163508981810 , 1443579668195315844

# --- سر الجلسة (قيمة سرية عشوائية) ---
SESSION_SECRET=YOUR_LONG_RANDOM_SESSION_SECRET_HERE

# --- رابط الإعادة بعد تسجيل الدخول ---
# محلياً:
REDIRECT_URI=http://localhost:3001/api/auth/callback
# على Render: ضع رابط خدمتك، مثال:
# REDIRECT_URI=https://your-app.onrender.com/api/auth/callback

# --- Live Reload (يفعّل تلقائياً إلا في الإنتاج) ---
ENABLE_LIVE_RELOAD=true

# --- المصمم ---
# البريد الإلكتروني للمصمم (اختياري)
DESIGNER_EMAIL=
# رابط Discord للمصمم (اختياري)
DESIGNER_DISCORD_URL=
