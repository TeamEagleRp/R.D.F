# ============================================
# R.D.F - إعدادات البيئة (Environment Variables)
# انسخ هذا الملف إلى ".env" وعبّئ القيم الفعلية.
# لا ترفع ملف ".env" الحقيقي إلى GitHub أبداً.
# ============================================

# المنفذ (افتراضياً 3000)
PORT=3000

# --- Discord Application (من Discord Developer Portal) ---
# Client ID
DISCORD_CLIENT_ID=1534884276645134478
# Client Secret
DISCORD_CLIENT_SECRET=fSRAwFcjt7Svwyad71xfORJBx4hatQxk

# --- Discord Bot ---
DISCORD_BOT_TOKEN=YOUR_TOKEN_HERE
# --- السيرفر ---
# ايدي سيرفر الديسكورد
DISCORD_GUILD_ID=1511172687463186553
# رابط دعوة السيرفر
DISCORD_INVITE=https://discord.gg/rhARTUuX7u

# --- القادة الذين يمكنهم الكتابة (مفصولة بفواصل) ---
ADMIN_IDS=1443547306518642703,1037375163508981810,1511111399558873178,1490661913288380488

# --- سر الجلسة (قيمة سرية عشوائية) ---
SESSION_SECRET=change-this-to-a-long-random-string

# --- رابط الإعادة بعد تسجيل الدخول ---
# محلياً:
# REDIRECT_URI=http://localhost:3000/api/auth/callback
# بعد النشر على Render:
# REDIRECT_URI=https://your-app.onrender.com/api/auth/callback
REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Live Reload (يفعّل تلقائياً إلا في الإنتاج) ---
ENABLE_LIVE_RELOAD=true
