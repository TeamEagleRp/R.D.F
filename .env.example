# Discord OAuth2 Application
# Create at https://discord.com/developers/applications
DISCORD_CLIENT_ID=YOUR_CLIENT_ID_HERE
DISCORD_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
# Optional: Only needed if you want to verify membership in the server
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# OAuth redirect URL (must match Discord app redirect)
REDIRECT_URI=http://localhost:3000/api/auth/callback

# Server (guild) ID
DISCORD_GUILD_ID=YOUR_GUILD_ID_HERE

# Invite link
DISCORD_INVITE=YOUR_INVITE_LINK_HERE

# Admin leader IDs who can write (comma separated)
ADMIN_IDS=ID1,ID2,ID3

# Server port
PORT=3000

# Session secret
SESSION_SECRET=change_this_to_a_random_long_string
